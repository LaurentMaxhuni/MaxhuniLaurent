# Single canonical public origin used for metadata, structured data, feeds,
# sitemaps, robots.txt, API documentation, and absolute internal links.
# Change this one value when the authoritative production domain changes.
NEXT_PUBLIC_SITE_URL=https://laurentmaxhuni.vercel.app

# Optional: paste only the token supplied by Google Search Console. The app renders
# <meta name="google-site-verification"> at build and request time when this is set.
GOOGLE_SITE_VERIFICATION=your-google-search-console-token
